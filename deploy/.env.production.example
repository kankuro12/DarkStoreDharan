# DarkStore Nepal - production environment template.
# Copy to app/.env on the server and fill the secrets (see CREDENTIALS.md).
APP_NAME="DarkStore Nepal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://darkstorenepal.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=darkstor_darkstore
DB_USERNAME=darkstor_darkstore
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.darkstorenepal.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# DirectAdmin host without a usable local SMTP auth flow -> local sendmail.
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs"
MAIL_FROM_ADDRESS="noreply@darkstorenepal.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
CURATOR_GLIDE_TOKEN=
